function doAdd(){
  var a=parseInt(document.getElementById('wAmt').value)||0;
  var u=document.getElementById('wUTR').value.trim();
  if(a<20){toast('Min ₹20!');return;}
  if(!u){toast('UTR!');return;}
  if(!user){toast('Login!');return;}
  // Check duplicate UTR
  for(var i=0;i<pTop.length;i++){if(pTop[i].utr===u){toast('⚠️ UTR already used!');return;}}
  pTop.push({name:user.name,email:user.email,phone:user.phone,amount:a,utr:u,status:'pending'});
  wHist.push({email:user.email,type:'topup',amount:a,status:'pending',note:'UTR:'+u});
