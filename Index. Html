  window.open('https://wa.me/'+ADM_PHONE+'?text='+encodeURIComponent('💰 ADD MONEY\nName: '+user.name+'\nEmail: '+user.email+'\nAmount: ₹'+a+'\nUTR: '+u),'_blank');
}
 
function doWd(){
  var a=parseInt(document.getElementById('wdA').value)||0;
  var u=document.getElementById('wdU').value.trim();
  if(a<50){toast('Min ₹50!');return;}
  if(a>(user.balance||0)){toast('Balance kam!');return;}
  if(!u){toast('UPI!');return;}
  user.balance=(user.balance||0)-a;
  pWd.push({name:user.name,email:user.email,amount:a,upi:u,status:'pending'});
  wHist.push({email:user.email,type:'withdraw',amount:a,status:'pending',note:'To:'+u});
