<html>
 <head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Booyah League</title>
  <style>
body{margin:0;background:#0a0a1a;color:#fff;font-family:sans-serif;padding-bottom:60px}
.top{background:#111;padding:12px 16px;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:100}
.top b{color:#ffd700;font-size:16px}
.chip{padding:6px 14px;border-radius:20px;font-size:12px;font-weight:700;cursor:pointer;border:1px solid #333;background:#161638;color:#aaa}
.chip.on{color:#0f0;border-color:#0f0}
.wchip{background:#2a2200;color:#ffd700;border:1px solid #554400;display:none;cursor:pointer}
.hero{background:linear-gradient(135deg,#1a0f00,#0a1a2a);border:1px solid #333;border-radius:16px;padding:20px;margin:16px}
.hero h1{font-size:24px;font-weight:900}.hero h1 span{color:#ffd700}
.stats{display:flex;gap:10px;margin-top:12px}
.stat{background:rgba(0,0,0,.3);border:1px solid #333;border-radius:10px;padding:10px;text-align:center;flex:1}
.stat b{color:#ffd700;font-size:18px;display:block}.stat small{color:#666;font-size:8px;text-transform:uppercase}
.box{background:#111;border:1px solid #333;border-radius:14px;padding:16px;margin:0 16px 12px}
.card{background:#111;border:1px solid #333;border-radius:14px;padding:16px;margin:0 16px 12px}
.prize{background:#2a2200;border:1px solid #554400;border-radius:10px;padding:10px;display:flex;justify-content:space-between;margin:8px 0}
.prize small{color:#ffd700;font-size:9px;text-transform:uppercase}.prize b{color:#ffd700;font-size:18px}
.meta{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:6px;margin:8px 0}
.mi{background:#161638;border-radius:8px;padding:8px;text-align:center}
.mi small{font-size:8px;color:#666;text-transform:uppercase;display:block}.mi b{font-size:13px}
.badge{padding:4px 12px;border-radius:20px;font-size:9px;font-weight:800;display:inline-block}
.badge.o{background:rgba(0,230,118,.1);color:#0f0;border:1px solid rgba(0,230,118,.3)}
.badge.b{background:rgba(255,107,43,.1);color:#ff6b2b;border:1px solid rgba(255,107,43,.3)}
.badge.m{background:rgba(255,255,255,.03);color:#aaa;border:1px solid #333;font-size:8px}
.acts{display:flex;gap:8px;margin-top:8px}
.btn{padding:10px 16px;border-radius:8px;border:none;font-size:13px;font-weight:700;cursor:pointer;color:#fff}
.btn.o{background:#ff6b2b}.btn.g{background:#25D366}.btn.b{background:#0088cc}
.btn.p{background:linear-gradient(135deg,#ff6b2b,#e65100);width:100%;padding:14px;font-size:16px}
.btn.x{background:transparent;border:1px solid #333;color:#aaa;width:100%;padding:12px;margin-top:8px}
.overlay{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.9);z-index:200;display:none;overflow-y:auto;padding:16px}
.overlay.show{display:block}
.mbox{background:#111;border:1px solid #333;border-radius:16px;padding:20px;max-width:400px;margin:20px auto}
.mbox h3{margin-bottom:8px}.mbox p{color:#aaa;font-size:13px;margin-bottom:16px}
.mbox label{font-size:10px;color:#666;display:block;margin-bottom:4px;font-weight:700}
.mbox input,.mbox select,.mbox textarea{width:100%;background:#161638;border:1px solid #333;border-radius:8px;padding:14px;color:#fff;font-size:16px;margin-bottom:12px;font-family:sans-serif}
.mbox textarea{min-height:80px;resize:vertical}
.mbox select{appearance:none}
.bal{background:#2a2200;border:1px solid #554400;border-radius:12px;padding:16px;text-align:center;margin-bottom:12px}
.bal small{font-size:10px;color:#666;display:block}.bal b{font-size:28px;color:#ffd700}
.wtabs{display:flex;gap:6px;margin-bottom:14px}
.wtab{flex:1;background:#161638;border:1px solid #333;color:#aaa;padding:10px;border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;text-align:center}
.wtab.on{background:#2a1508;border-color:#ff6b2b;color:#ff6b2b}
.upi{background:#161638;border:1px solid #333;border-radius:12px;padding:16px;text-align:center;margin-bottom:12px}
.upi b{color:#ffd700;font-family:monospace;font-size:16px;display:block;margin-top:8px}
.upi small{color:#666;display:block;margin-top:4px}
.nav{position:fixed;bottom:0;left:0;right:0;background:#111;border-top:1px solid #333;display:flex;z-index:100}
.nav button{flex:1;padding:12px;background:none;border:none;color:#666;font-size:10px;font-weight:700;cursor:pointer}
.nav button.on{color:#ffd700}
.acard{background:#111;border:1px solid #333;border-radius:14px;padding:16px;margin:0 16px 14px}
.acard h4{margin-bottom:8px}
.acard label{font-size:10px;color:#666;display:block;margin-bottom:4px;font-weight:700}
.acard input,.acard select,.acard textarea{width:100%;background:#161638;border:1px solid #333;border-radius:8px;padding:11px;color:#fff;font-size:14px;margin-bottom:10px;font-family:sans-serif}
.acard textarea{min-height:60px;resize:vertical}
.acard select{appearance:none}
.gt-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:12px}
.gt-card{background:#161638;border:2px solid #333;border-radius:10px;padding:12px;text-align:center;cursor:pointer}
.gt-card.sel{border-color:#ff6b2b}
.map-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;margin-bottom:12px}
.map-card{background:#161638;border:2px solid #333;border-radius:10px;padding:10px;text-align:center;cursor:pointer}
.map-card.sel{border-color:#00e5ff}
.prow{display:flex;gap:10px;background:#161638;border:1px solid #333;border-radius:10px;padding:12px;margin-bottom:8px;align-items:center;flex-wrap:wrap}
.prow .av{width:36px;height:36px;border-radius:8px;background:rgba(255,107,43,.1);color:#ff6b2b;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:12px}
.prow .info{flex:1}.prow .info .n{font-size:13px;font-weight:700}.prow .info .s{font-size:11px;color:#666}
.ab{background:rgba(0,230,118,.1);border:1px solid rgba(0,230,118,.3);color:#0f0;padding:7px 14px;border-radius:6px;font-size:11px;font-weight:800;cursor:pointer}
.rb{background:rgba(255,71,87,.1);border:1px solid rgba(255,71,87,.3);color:#f44;padding:7px 14px;border-radius:6px;font-size:11px;font-weight:800;cursor:pointer;margin-left:6px}
.pill{display:inline-block;padding:3px 8px;border-radius:20px;font-size:9px;font-weight:800}
.pill.g{background:rgba(0,230,118,.1);color:#0f0}.pill.p{background:rgba(124,77,255,.1);color:#7c4dff}
.toast{position:fixed;bottom:70px;left:50%;transform:translateX(-50%);background:#1a2030;border:1px solid #333;border-radius:16px;padding:12px 20px;font-size:13px;font-weight:600;z-index:999;opacity:0;transition:opacity .3s;max-width:85vw;text-align:center}
.toast.show{opacity:1}
.saved-user{background:#161638;border:1px solid #333;border-radius:8px;padding:10px 12px;margin-bottom:6px;cursor:pointer;display:flex;align-items:center;gap:10px}
.saved-user:hover{border-color:#ff6b2b}
</style>
 </head>
 <body>
  <div class="top">
   <b>BOOYAH LEAGUE</b>
   <div style="display:flex;gap:8px">
    <div class="wchip" id="wC" onclick="openW()">
     ₹<span id="wB">0</span>
    </div>
    <div class="chip" id="uC" onclick="showLogin()">Login</div>
   </div>
  </div>
  <div id="pg-home">
   <div class="hero">
    <div style="display:inline-block;background:rgba(255,71,87,.1);border:1px solid rgba(255,71,87,.3);border-radius:20px;padding:4px 12px;font-size:10px;font-weight:800;color:#f44;margin-bottom:10px">LIVE</div>
    <h1>COMPETE.
     <br>
     <span>WIN BIG.</span></h1>
    <p>Join tournaments, win prizes.</p>
    <div class="stats">
     <div class="stat">
      <b id="hT">0</b><small>Teams</small>
     </div>
     <div class="stat">
      <b id="hP">₹0</b><small>Prize</small>
     </div>
     <div class="stat">
      <b id="hR">0</b><small>Tournaments</small>
     </div>
    </div>
   </div>
   <div class="box">
    <h4>📤 Invite Friends</h4>
    <div style="display:flex;gap:8px;margin-bottom:8px">
     <input id="sU" type="text" readonly>
     <button class="btn o" onclick="copyL()">Copy</button>
    </div>
    <div style="display:flex;gap:8px">
     <button class="btn g" onclick="shareWA()" style="flex:1">WhatsApp</button>
     <button class="btn b" onclick="shareTG()" style="flex:1">Telegram</button>
    </div>
   </div>
   <div id="fT" style="display:flex;gap:6px;padding:0 16px;margin-bottom:16px;overflow-x:auto"></div>
   <div id="tL"></div>
  </div>
  <div id="pg-teams" style="display:none;padding:16px">
   <div style="font-size:12px;font-weight:800;color:#666;text-transform:uppercase;margin-bottom:12px">
    Teams (<span id="tC">0</span>)
   </div>
   <div id="teamList"></div>
  </div>
  <div id="pg-score" style="display:none;padding:16px">
   <div style="font-size:12px;font-weight:800;color:#666;text-transform:uppercase;margin-bottom:12px">Scoreboard</div>
   <div id="sL"></div>
  </div>
  <div id="pg-admin" style="display:none">
   <div class="acard">
    <h4>Create Tournament</h4>
    <label>Name</label><input id="aN" placeholder="Squad Showdown"> <label>Game Type</label>
    <div class="gt-grid" id="gG"></div>
    <label>Map</label>
    <div class="map-grid" id="mG"></div>
    <label>Entry Fee</label><input id="aF" type="number" value="100"> <label>Prize Pool</label><input id="aP" type="number" value="1000"> <label>Per Kill</label><input id="aK" type="number" value="10"> <label>Winner Bonus</label><input id="aB" type="number" value="50"> <label>Max Teams</label><input id="aM" type="number" value="40"> <label>Per Lobby</label><select id="aL"><option>10</option><option>8</option><option>6</option></select> <label>Rules (one per line)</label><textarea id="aR" placeholder="No hacking
No cheating"></textarea> <label>Banned Items (one per line)</label><textarea id="aBI" placeholder="M1887 banned
Chrono banned"></textarea>
    <button class="btn p" onclick="createT()">Create Tournament</button>
   </div>
   <div class="acard" id="rC" style="display:none">
    <h4>Room Details</h4>
    <select id="rS" onchange="renderLob()"></select>
    <div id="lR"></div>
   </div>
   <div class="acard">
    <h4>Pending Payments <span id="pB" style="background:#f44;color:#fff;font-size:10px;padding:2px 8px;border-radius:20px;display:none">0</span></h4>
    <div id="pL"></div>
   </div>
   <div class="acard">
    <h4>Add Money <span id="tB" style="background:#f44;color:#fff;font-size:10px;padding:2px 8px;border-radius:20px;display:none">0</span></h4>
    <div id="addL"></div>
   </div>
   <div class="acard">
    <h4>Withdraw <span id="wB2" style="background:#f44;color:#fff;font-size:10px;padding:2px 8px;border-radius:20px;display:none">0</span></h4>
    <div id="wL"></div>
   </div>
   <div class="acard">
    <h4>Winners</h4>
    <div id="wF"></div>
   </div>
  </div>
  <div class="nav">
   <button class="on" onclick="go('home',this)">Home</button>
   <button onclick="go('teams',this)">Teams</button>
   <button onclick="go('score',this)">Score</button>
   <button onclick="go('admin',this)">Admin</button>
  </div>
  <!-- LOGIN MODAL -->
  <div class="overlay" id="loginOv">
   <div class="mbox">
    <h3>Login</h3>
    <p>Sign in to join tournaments.</p>
    <div id="savedArea" style="display:none;margin-bottom:14px">
     <div style="font-size:11px;color:#666;margin-bottom:8px;font-weight:700">Saved accounts:</div>
     <div id="savedList"></div>
    </div>
    <label>Name</label><input id="lN" placeholder="Your name" autocomplete="name"> <label>Email</label><input id="lE" type="email" placeholder="email@example.com" autocomplete="email"> <label>Phone</label><input id="lP" type="tel" placeholder="9876543210" autocomplete="tel">
    <button class="btn p" id="loginBtn">Login</button>
    <button class="btn x" onclick="hideO('loginOv')">Cancel</button>
   </div>
  </div>
  <div class="overlay" id="joinOv">
   <div class="mbox" id="jC"></div>
  </div>
  <div class="overlay" id="detOv">
   <div class="mbox" id="dC"></div>
  </div>
  <div class="overlay" id="walOv">
   <div class="mbox">
    <h3>Wallet</h3>
    <div class="bal">
     <small>Balance</small><b id="walB">₹0</b>
    </div>
    <div class="wtabs">
     <div class="wtab on" id="wtAdd">Add</div>
     <div class="wtab" id="wtWd">Withdraw</div>
     <div class="wtab" id="wtHist">History</div>
    </div>
    <div id="walC"></div>
    <button class="btn x" id="walCloseBtn">Close</button>
   </div>
  </div>
  <div class="toast" id="toast"></div>
  <script>
var ADM='sunitamaurya3217@gmail.com';
var SITE_URL='https://arjunvishwas1172-a11y.github.io/Indian-tournament/';
var UPI='9324214729@kotakbank';
var UPIN='Shivkumar Pitambar Maurya';
var ADM_PHONE='919324214729';
var user=null,teams=[],tournaments=[],pPay=[],pTop=[],pWd=[],wHist=[];
var tid=1,tmId=1,filter='all',sGT='br',sMap='bermuda';
var GT=[{id:'br',e:'🔥',n:'BR'},{id:'cs',e:'⚔️',n:'CS'},{id:'lw',e:'🐺',n:'Lone Wolf'},{id:'custom',e:'🎪',n:'Custom'}];
var MAPS=[{id:'bermuda',e:'🏝️',n:'Bermuda'},{id:'kalahari',e:'🏜️',n:'Kalahari'},{id:'purgatory',e:'🌋',n:'Purgatory'},{id:'alpine',e:'🏔️',n:'Alpine'},{id:'nexterra',e:'🌆',n:'Nexterra'},{id:'solara',e:'🏟️',n:'Solara'}];
 
// LOAD
try{var d=localStorage.getItem('bl');if(d){var s=JSON.parse(d);teams=s.teams||[];pPay=s.pPay||[];pTop=s.pTop||[];pWd=s.pWd||[];wHist=s.wHist||[];tid=s.tid||1;tmId=s.tmId||1;}}catch(e){}
try{var t=localStorage.getItem('bl_t');if(t)tournaments=JSON.parse(t);}catch(e){}
try{var u=localStorage.getItem('bl_u');if(u){user=JSON.parse(u);var us=JSON.parse(localStorage.getItem('bl_us')||'{}');if(user&&user.email&&us[user.email])user.balance=us[user.email].balance||0;updUI();}}catch(e){}
 
document.getElementById('sU').value=SITE_URL;
 
function save(){try{localStorage.setItem('bl',JSON.stringify({teams:teams,pPay:pPay,pTop:pTop,pWd:pWd,wHist:wHist,tid:tid,tmId:tmId}));localStorage.setItem('bl_t',JSON.stringify(tournaments));}catch(e){}if(user&&user.email){try{var u=JSON.parse(localStorage.getItem('bl_us')||'{}');u[user.email]=user;localStorage.setItem('bl_us',JSON.stringify(u));localStorage.setItem('bl_u',JSON.stringify(user));}catch(e){}}}
function esc(s){var d=document.createElement('div');d.textContent=s;return d.innerHTML;}
function toast(m){var t=document.getElementById('toast');t.textContent=m;t.classList.add('show');setTimeout(function(){t.classList.remove('show');},2500);}
function showO(id){document.getElementById(id).classList.add('show');}
function hideO(id){document.getElementById(id).classList.remove('show');}
function copyL(){try{navigator.clipboard.writeText(SITE_URL);toast('Copied!');}catch(e){prompt('Copy:',SITE_URL);}}
function shareWA(){window.open('https://wa.me/?text='+encodeURIComponent('🔥 BOOYAH LEAGUE!\n'+SITE_URL),'_blank');}
function shareTG(){window.open('https://t.me/share/url?url='+encodeURIComponent(SITE_URL),'_blank');}
 
// NAV
function go(p,b){
  document.querySelectorAll('.nav button').forEach(function(x){x.classList.remove('on');});
  if(b)b.classList.add('on');
  ['home','teams','score','admin'].forEach(function(k){document.getElementById('pg-'+k).style.display=k===p?'block':'none';});
  if(p==='admin'){
    if(!user||!user.email){toast('Login first!');go('home',document.querySelector('.nav button'));return;}
    if(user.email.trim().toLowerCase()!==ADM.trim().toLowerCase()){toast('Admin only! Logged in as: '+user.email);go('home',document.querySelector('.nav button'));return;}
    renderAdmin();
  }
  if(p==='teams')renderTeams();
  if(p==='score')renderScore();
}
 
// FILTER
function setF(f){filter=f;renderF();renderHome();}
function renderF(){
  var tabs=[{id:'all',l:'All'},{id:'br',l:'🔥 BR'},{id:'cs',l:'⚔️ CS'},{id:'lw',l:'🐺 Lone Wolf'},{id:'custom',l:'Custom'}];
  var h='';for(var i=0;i<tabs.length;i++){h+='<div style="padding:10px 16px;border-radius:20px;font-size:11px;font-weight:700;border:1px solid '+(filter===tabs[i].id?'#ff6b2b':'#333')+';background:'+(filter===tabs[i].id?'#2a1508':'#111')+';color:'+(filter===tabs[i].id?'#ff6b2b':'#aaa')+';cursor:pointer;white-space:nowrap" onclick="setF(\''+tabs[i].id+'\')">'+tabs[i].l+'</div>';}
  document.getElementById('fT').innerHTML=h;
}
 
function renderGT(){var h='';for(var i=0;i<GT.length;i++){h+='<div class="gt-card'+(sGT===GT[i].id?' sel':'')+'" onclick="sGT=\''+GT[i].id+'\';renderGT()"><div style="font-size:24px">'+GT[i].e+'</div><div style="font-size:10px;font-weight:800">'+GT[i].n+'</div></div>';}document.getElementById('gG').innerHTML=h;}
function renderMAP(){var h='';for(var i=0;i<MAPS.length;i++){h+='<div class="map-card'+(sMap===MAPS[i].id?' sel':'')+'" onclick="sMap=\''+MAPS[i].id+'\';renderMAP()"><div style="font-size:18px">'+MAPS[i].e+'</div><div style="font-size:9px;font-weight:700">'+MAPS[i].n+'</div></div>';}document.getElementById('mG').innerHTML=h;}
 
// LOGIN
function showLogin(){
  if(user){openW();return;}
  // Show saved accounts
  var savedArea=document.getElementById('savedArea');
  var savedList=document.getElementById('savedList');
  var users=JSON.parse(localStorage.getItem('bl_us')||'{}');
  var keys=Object.keys(users);
  if(keys.length>0){
    savedArea.style.display='block';
    savedList.innerHTML='';
    for(var i=0;i<keys.length;i++){
      var u=users[keys[i]];
      var div=document.createElement('div');
      div.className='saved-user';
      div.innerHTML='<div style="width:32px;height:32px;border-radius:8px;background:rgba(255,107,43,.1);color:#ff6b2b;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:12px">'+u.name[0].toUpperCase()+'</div><div><div style="font-size:13px;font-weight:700">'+esc(u.name)+'</div><div style="font-size:11px;color:#666">'+esc(u.email)+'</div></div>';
      div.setAttribute('data-email',u.email);
      div.onclick=function(){
        var e=this.getAttribute('data-email');
        var u=JSON.parse(localStorage.getItem('bl_us')||'{}');
        if(u[e]){
          user={name:u[e].name,email:u[e].email,phone:u[e].phone||'',balance:u[e].balance||0};
          try{localStorage.setItem('bl_u',JSON.stringify(user));}catch(x){}
          updUI();hideO('loginOv');toast('Welcome back, '+user.name+'!');
        }
      };
      savedList.appendChild(div);
    }
  }else{savedArea.style.display='none';}
  showO('loginOv');
}
 
// Login button handler
document.getElementById('loginBtn').onclick=function(){
  var n=document.getElementById('lN').value.trim();
  var e=document.getElementById('lE').value.trim().toLowerCase();
  var p=document.getElementById('lP').value.trim();
  if(!n||!e||!p){toast('All fields!');return;}
  var eb=0;
  try{var u=JSON.parse(localStorage.getItem('bl_us')||'{}');if(u[e])eb=u[e].balance||0;}catch(x){}
  user={name:n,email:e,phone:p,balance:eb};
  try{var u=JSON.parse(localStorage.getItem('bl_us')||'{}');u[e]=user;localStorage.setItem('bl_us',JSON.stringify(u));localStorage.setItem('bl_u',JSON.stringify(user));}catch(x){}
  updUI();hideO('loginOv');toast('Welcome, '+n+'! Balance: ₹'+eb);
};
 
function updUI(){
  if(!user)return;
  try{var u=JSON.parse(localStorage.getItem('bl_us')||'{}');if(user.email&&u[user.email])user.balance=u[user.email].balance||0;}catch(x){}
  document.getElementById('uC').textContent='✅ '+user.name;document.getElementById('uC').classList.add('on');
  document.getElementById('wC').style.display='flex';document.getElementById('wB').textContent=user.balance||0;
}
 
// WALLET
function openW(){if(!user){showO('loginOv');return;}document.getElementById('walB').textContent='₹'+(user.balance||0);swT('add');showO('walOv');}
 
// Wallet close button
document.getElementById('walCloseBtn').onclick=function(){hideO('walOv');};
 
// Wallet tab buttons
document.getElementById('wtAdd').onclick=function(){swT('add');};
document.getElementById('wtWd').onclick=function(){swT('wd');};
document.getElementById('wtHist').onclick=function(){swT('hist');};
 
function swT(tab){
  document.getElementById('wtAdd').classList.toggle('on',tab==='add');
  document.getElementById('wtWd').classList.toggle('on',tab==='wd');
  document.getElementById('wtHist').classList.toggle('on',tab==='hist');
  var c=document.getElementById('walC');c.innerHTML='';
  if(tab==='add'){
