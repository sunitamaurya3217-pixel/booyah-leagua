// WINNERS
function renderWF(){var el=document.getElementById('wF');var ts=[];for(var i=0;i<tournaments.length;i++){if(tournaments[i].status==='ongoing')ts.push(tournaments[i]);}if(!ts.length){el.innerHTML='<p style="font-size:12px;color:#666">No ongoing.</p>';return;}var h='';for(var i=0;i<ts.length;i++){var t=ts[i];var tT=[];for(var j=0;j<teams.length;j++){if(teams[j].tid===t.id)tT.push(teams[j]);}h+='<div style="margin-bottom:16px"><p style="font-weight:800">'+esc(t.name)+'</p>';for(var r=1;r<=3;r++){h+='<div style="display:flex;gap:8px;margin-bottom:8px"><span style="color:#ffd700;font-weight:900">#'+r+'</span><select id="w'+t.id+'s'+r+'" style="flex:1;background:#161638;border:1px solid #333;border-radius:6px;padding:8px;color:#fff;font-size:12px"><option value="">Select</option>';for(var k=0;k<tT.length;k++){h+='<option value="'+esc(tT[k].name)+'">'+esc(tT[k].name)+'</option>';}h+='</select><input id="w'+t.id+'p'+r+'" type="number" placeholder="₹" style="width:70px;background:#161638;border:1px solid #333;border-radius:6px;padding:8px;color:#fff;font-size:12px"></div>';}h+='<button class="ab" style="width:100%;padding:10px" onclick="annW('+t.id+')">Announce</button></div>';}el.innerHTML=h;}
function annW(id){var t=null;for(var i=0;i<tournaments.length;i++){if(tournaments[i].id===id){t=tournaments[i];break;}}if(!t)return;t.winners=[];for(var r=1;r<=3;r++){var sel=document.getElementById('w'+id+'s'+r),inp=document.getElementById('w'+id+'p'+r);if(sel&&sel.value)t.winners.push({team:sel.value,prize:parseInt(inp.value)||0});}if(t.winners.length){t.status='completed';save();renderHome();toast('Winners announced!');}}
 
// INIT
renderF();renderHome();updateBadges();
setInterval(function(){try{var d=localStorage.getItem('bl');if(d){var s=JSON.parse(d);teams=s.teams||[];pPay=s.pPay||[];pTop=s.pTop||[];pWd=s.pWd||[];wHist=s.wHist||[];}var t=localStorage.getItem('bl_t');if(t)tournaments=JSON.parse(t);if(user){var u=JSON.parse(localStorage.getItem('bl_us')||'{}');if(user.email&&u[user.email])user.balance=u[user.email].balance||0;updUI();}updateBadges();renderHome();}catch(e){}},5000);
</script>
